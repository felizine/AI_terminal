<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AITerminal.UI.ViewModels"
        x:Class="AITerminal.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AI Terminal"
        Width="1440"
        Height="900"
        MinWidth="440"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid RowDefinitions="68,*">
        <!-- Top bar -->
        <Border Grid.Row="0"
                Background="#0E161E"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal"
                            Spacing="11"
                            VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="10"
                            Background="{DynamicResource BrandGradientBrush}">
                        <TextBlock Text="A"
                                   Foreground="#071612"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="AI Terminal"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="BrandSubtitle"
                                   Text="Personal assistant"
                                   Classes="caption" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="TopConversationTitle"
                           Grid.Column="1"
                           Text="{Binding ConversationTitle}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="24,0" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="7"
                            VerticalAlignment="Center">
                    <Border x:Name="ConnectionPill"
                            Classes="pill muted"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="{DynamicResource WarningBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       Classes="pillText muted" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="RailToggleButton"
                            Classes="icon"
                            Content="◷"
                            FontSize="17"
                            Command="{Binding OpenTodayCommand}"
                            ToolTip.Tip="Open today's briefing"
                            AutomationProperties.Name="Open today's briefing" />
                    <Button Classes="icon"
                            Content="⚙"
                            FontSize="16"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Environment settings"
                            AutomationProperties.Name="Open environment settings" />
                    <Border Width="32"
                            Height="32"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceHoverBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Margin="4,0,0,0">
                        <TextBlock Text="F"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main shell -->
        <Grid x:Name="BodyGrid"
              Grid.Row="1"
              ColumnDefinitions="236,*,332">

            <!-- Navigation -->
            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14,20">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel x:Name="SidebarExpandedContent" Spacing="8">
                        <Button Classes="primary"
                                Content="＋  New conversation"
                                Command="{Binding NewConversationCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Margin="0,0,0,12" />
                        <TextBlock Text="WORKSPACE"
                                   Classes="eyebrow muted"
                                   FontSize="10"
                                   Margin="10,5,0,3" />
                        <Button Classes="nav"
                                Command="{Binding OpenTodayCommand}"
                                HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="◷" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="Today"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Classes="nav"
                                Command="{Binding OpenTasksCommand}"
                                HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="✓" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="Tasks"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Classes="nav"
                                Command="{Binding OpenScheduleCommand}"
                                HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="□" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="Schedule"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Button>
                        <Button Classes="nav"
                                Command="{Binding OpenSettingsCommand}"
                                HorizontalContentAlignment="Stretch">
                            <Grid ColumnDefinitions="24,*">
                                <TextBlock Text="⚙" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="Settings"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="SidebarCompactContent"
                                Spacing="8"
                                IsVisible="False">
                        <Button Classes="primary"
                                Content="＋"
                                Command="{Binding NewConversationCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                ToolTip.Tip="New conversation"
                                AutomationProperties.Name="New conversation" />
                        <Button Classes="nav"
                                Content="◷"
                                FontSize="17"
                                Command="{Binding OpenTodayCommand}"
                                HorizontalAlignment="Center"
                                ToolTip.Tip="Today"
                                AutomationProperties.Name="Open today" />
                        <Button Classes="nav"
                                Content="✓"
                                FontSize="16"
                                Command="{Binding OpenTasksCommand}"
                                HorizontalAlignment="Center"
                                ToolTip.Tip="Tasks"
                                AutomationProperties.Name="Open tasks" />
                        <Button Classes="nav"
                                Content="□"
                                FontSize="17"
                                Command="{Binding OpenScheduleCommand}"
                                HorizontalAlignment="Center"
                                ToolTip.Tip="Schedule"
                                AutomationProperties.Name="Open schedule" />
                        <Button Classes="nav"
                                Content="⚙"
                                FontSize="16"
                                Command="{Binding OpenSettingsCommand}"
                                HorizontalAlignment="Center"
                                ToolTip.Tip="Settings"
                                AutomationProperties.Name="Open settings" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Classes="card"
                            Padding="11"
                            Margin="0,14,0,0">
                        <StackPanel Spacing="5">
                            <TextBlock Text="PHASE 1"
                                       Classes="eyebrow"
                                       FontSize="9" />
                            <TextBlock Text="Local foundation"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="History is stored on this device."
                                       Classes="caption"
                                       LineHeight="16" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Chat and adaptive workspace -->
            <Grid x:Name="ContentGrid"
                  Grid.Column="1"
                  ColumnDefinitions="*,0,0">

                <Grid x:Name="ChatPanel"
                      Grid.Column="0"
                      RowDefinitions="Auto,*,Auto,Auto">

                    <Border Grid.Row="0"
                            Padding="28,20"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding Greeting}" Classes="h2" />
                                <TextBlock Text="{Binding DisplayDate}"
                                           Classes="secondary"
                                           FontSize="13" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="ghost"
                                    Content="Review today"
                                    Command="{Binding OpenTodayCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="ChatScroll"
                                      IsVisible="{Binding HasMessages}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="28,22">
                            <ItemsControl ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChatMessageViewModel">
                                        <Grid Margin="0,0,0,22">
                                            <StackPanel IsVisible="{Binding IsUser}"
                                                        HorizontalAlignment="Right"
                                                        MaxWidth="680"
                                                        Spacing="5">
                                                <Border Background="{DynamicResource UserBubbleBrush}"
                                                        BorderBrush="#23465F"
                                                        BorderThickness="1"
                                                        CornerRadius="14,14,4,14"
                                                        Padding="16,12">
                                                    <SelectableTextBlock Text="{Binding Content}"
                                                                         TextWrapping="Wrap"
                                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                                         LineHeight="21" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="7"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="You" Classes="caption" />
                                                    <TextBlock Text="·" Classes="caption" />
                                                    <TextBlock Text="{Binding TimeLabel}" Classes="caption" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel IsVisible="{Binding IsAssistant}"
                                                        HorizontalAlignment="Left"
                                                        MaxWidth="720"
                                                        Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Classes="pill" Padding="8,3">
                                                        <TextBlock Text="AI" Classes="pillText" FontSize="9" />
                                                    </Border>
                                                    <TextBlock Text="Assistant" Classes="caption" VerticalAlignment="Center" />
                                                    <TextBlock Text="·" Classes="caption" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding TimeLabel}" Classes="caption" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border Background="{DynamicResource AssistantBubbleBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4,14,14,14"
                                                        Padding="16,13">
                                                    <StackPanel Spacing="8">
                                                        <SelectableTextBlock Text="{Binding Content}"
                                                                             TextWrapping="Wrap"
                                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                                             LineHeight="22" />
                                                        <StackPanel IsVisible="{Binding IsStreaming}"
                                                                    Orientation="Horizontal"
                                                                    Spacing="8">
                                                            <ProgressBar Width="48"
                                                                         Height="3"
                                                                         IsIndeterminate="True"
                                                                         IsVisible="{Binding !ReduceMotion}"
                                                                         VerticalAlignment="Center" />
                                                            <TextBlock Text="Responding locally..."
                                                                       Classes="caption"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty state and progressive disclosure -->
                        <ScrollViewer IsVisible="{Binding IsConversationEmpty}"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MaxWidth="680"
                                        Margin="30,40">
                                <Border Background="{DynamicResource HeroGlowBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="32">
                                    <StackPanel Spacing="18">
                                        <TextBlock Text="YOUR DAY, IN CONTEXT"
                                                   Classes="eyebrow" />
                                        <TextBlock Text="A calmer way to run the day."
                                                   Classes="h1"
                                                   MaxWidth="520" />
                                        <TextBlock Text="Start with the whole picture. The workspace opens only when a summary is not enough — with conflicts, priorities, and next steps already in view."
                                                   Classes="secondary"
                                                   FontSize="15"
                                                   LineHeight="23"
                                                   MaxWidth="560" />
                                        <StackPanel Orientation="Horizontal" Spacing="9">
                                            <Button Classes="primary"
                                                    Content="Show my day"
                                                    Command="{Binding OpenTodayCommand}" />
                                            <Button Classes="ghost"
                                                    Content="View tasks"
                                                    Command="{Binding OpenTasksCommand}" />
                                            <Button Classes="ghost"
                                                    Content="Check schedule"
                                                    Command="{Binding OpenScheduleCommand}" />
                                        </StackPanel>
                                        <Border Height="1"
                                                Background="#28433D"
                                                Margin="0,4" />
                                        <WrapPanel>
                                            <TextBlock Text="Local history"
                                                       Classes="caption"
                                                       Margin="0,0,20,4" />
                                            <TextBlock Text="Approval before actions"
                                                       Classes="caption"
                                                       Margin="0,0,20,4" />
                                            <TextBlock Text="No cloud model connected"
                                                       Classes="caption"
                                                       Margin="0,0,20,4" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Border Grid.Row="2"
                            IsVisible="{Binding HasError}"
                            Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="#6B3038"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,9"
                            Margin="28,0,28,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Classes="icon"
                                    Content="✕"
                                    FontSize="11"
                                    Command="{Binding ClearErrorCommand}"
                                    ToolTip.Tip="Dismiss"
                                    AutomationProperties.Name="Dismiss error" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="28,0,28,22" Spacing="10">
                        <StackPanel IsVisible="{Binding IsBusy}"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    Margin="2,0">
                            <ProgressBar Width="68"
                                         Height="3"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding !ReduceMotion}"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="Assistant is responding"
                                       Classes="caption"
                                       VerticalAlignment="Center" />
                            <Button Classes="danger"
                                    Content="Stop"
                                    Command="{Binding CancelResponseCommand}"
                                    MinHeight="28"
                                    Padding="10,4" />
                        </StackPanel>

                        <Border Background="{DynamicResource SurfaceRaisedBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Padding="14,11">
                            <Grid RowDefinitions="Auto,Auto">
                                <TextBox x:Name="ComposerBox"
                                         Text="{Binding ComposerText, Mode=TwoWay}"
                                         PlaceholderText="Ask what needs your attention…"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="54"
                                         MaxHeight="150"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="2,4"
                                         FontSize="14"
                                         KeyDown="OnComposerKeyDown" />
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="Auto,Auto,*,Auto"
                                      Margin="0,7,0,0">
                                    <Button Classes="icon"
                                            Content="＋"
                                            FontSize="16"
                                            IsEnabled="False"
                                            ToolTip.Tip="Attachments arrive in a later phase"
                                            AutomationProperties.Name="Attach file, unavailable" />
                                    <Button Grid.Column="1"
                                            Classes="icon"
                                            Content="◉"
                                            FontSize="14"
                                            IsEnabled="False"
                                            ToolTip.Tip="Local voice arrives in Phase 6"
                                            AutomationProperties.Name="Voice input, unavailable" />
                                    <TextBlock Grid.Column="2"
                                               Text="Enter to send · Shift+Enter for a new line"
                                               Classes="caption"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="8,0" />
                                    <Button Grid.Column="3"
                                            Classes="primary"
                                            Content="Send  ↑"
                                            Command="{Binding SendCommand}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <GridSplitter x:Name="WorkspaceSplitter"
                              Grid.Column="1"
                              Width="8"
                              Background="Transparent"
                              ResizeDirection="Columns"
                              IsVisible="False" />

                <Border x:Name="WorkspaceHost"
                        Grid.Column="2"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,0,0,0"
                        IsVisible="False">
                    <Grid RowDefinitions="Auto,*">
                        <Border Padding="24,18"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding ActiveWorkspace.Kicker}"
                                               Classes="eyebrow" />
                                    <TextBlock Text="{Binding ActiveWorkspace.Title}"
                                               Classes="h2" />
                                    <TextBlock Text="{Binding ActiveWorkspace.Description}"
                                               Classes="secondary"
                                               FontSize="12"
                                               MaxWidth="650"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        Content="✕"
                                        FontSize="13"
                                        Command="{Binding CloseWorkspaceCommand}"
                                        VerticalAlignment="Top"
                                        ToolTip.Tip="Close workspace"
                                        AutomationProperties.Name="Close workspace" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ContentControl Content="{Binding ActiveWorkspace}"
                                            Margin="24" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Notifications -->
            <Border x:Name="NotificationRail"
                    Grid.Column="2"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Padding="18,20,18,14"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="TODAY AT A GLANCE" Classes="eyebrow" />
                                <TextBlock Text="{Binding DisplayDate}"
                                           FontSize="15"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Classes="pill muted"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding NotificationCount}"
                                           Classes="pillText muted" />
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="14,14">
                        <StackPanel Spacing="10">
                            <ItemsControl ItemsSource="{Binding Notifications}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NotificationItemViewModel">
                                        <Border Classes="card"
                                                Classes.warning="{Binding IsWarning}"
                                                Padding="14"
                                                Margin="0,0,0,10">
                                            <StackPanel Spacing="9">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Width="30"
                                                            Height="30"
                                                            CornerRadius="9"
                                                            Background="{DynamicResource SurfaceHoverBrush}">
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="14"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1"
                                                                Spacing="2"
                                                                Margin="10,0,8,0">
                                                        <TextBlock Text="{Binding Category}"
                                                                   Classes="eyebrow"
                                                                   FontSize="9" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   LineHeight="18" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Meta}"
                                                               Classes="caption"
                                                               FontSize="10"
                                                               TextAlignment="Right"
                                                               MaxWidth="74" />
                                                </Grid>
                                                <TextBlock Text="{Binding Summary}"
                                                           Classes="secondary"
                                                           FontSize="12"
                                                           LineHeight="18" />
                                                <Button Classes="ghost"
                                                        Content="{Binding ActionLabel}"
                                                        Command="{Binding OpenCommand}"
                                                        IsVisible="{Binding HasAction}"
                                                        HorizontalAlignment="Left"
                                                        MinHeight="29"
                                                        Padding="10,4"
                                                        FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="{DynamicResource AccentSoftBrush}"
                                    BorderBrush="#285D51"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14"
                                    Margin="0,2,0,0">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="FOCUS WINDOW" Classes="eyebrow" FontSize="9" />
                                    <TextBlock Text="2 hours remain after 15:00"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Protected from low-priority meetings."
                                               Classes="caption"
                                               LineHeight="17" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="PHASE 1 · READ-ONLY"
                                       Classes="eyebrow muted"
                                       FontSize="9" />
                            <TextBlock Text="Sample briefing data. No external account is connected."
                                       Classes="caption"
                                       FontSize="10"
                                       LineHeight="15" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
