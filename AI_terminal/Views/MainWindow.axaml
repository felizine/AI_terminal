<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AI_terminal.ViewModels"
        x:Class="AI_terminal.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AI Companion Terminal"
        Width="500" Height="400"
        Background="#0a0a0a"> <Grid RowDefinitions="*, Auto" Margin="20">
        
        <Border Grid.Row="0" 
                BorderBrush="#00ffcc" BorderThickness="1" 
                CornerRadius="4" Padding="15" Background="#111111">
            <TextBlock Text="{Binding StatusText}" 
                       Foreground="#00ffcc" 
                       FontFamily="Courier New" 
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <Button Grid.Row="1" 
                Command="{Binding RefreshStatusCommand}" 
                Content="ACTIVATE AI PROTOCOL" 
                HorizontalAlignment="Center" 
                Margin="0,20,0,0"
                Padding="20,10"
                Background="#222222" Foreground="#00ffcc"
                BorderBrush="#00ffcc" BorderThickness="1"/>
    </Grid>
</Window>